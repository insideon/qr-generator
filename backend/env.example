# Google Drive 설정
# 본인의 Google Drive에서 폴더를 생성하고 Service Account와 공유한 후
# 해당 폴더의 ID를 여기에 입력하세요

# Google Drive 폴더 ID
# 폴더 URL: https://drive.google.com/drive/folders/[여기가_폴더_ID]
GOOGLE_DRIVE_FOLDER_ID=

# 설정 방법:
# 1. 이 파일을 복사하여 .env 파일로 저장: cp env.example .env
# 2. Google Drive에서 폴더 생성 (예: "QR_Codes")
# 3. 폴더를 Service Account와 공유 (편집자 권한)
# 4. 폴더 ID를 위의 GOOGLE_DRIVE_FOLDER_ID= 뒤에 입력

